# ==============================================================
# Variables de entorno para el despliegue en Sepolia
# ==============================================================
# Copia este archivo a .env y completa los valores:
#   cp .env.example .env
#
# IMPORTANTE: La cuenta asociada a PRIVATE_KEY debe tener
#             fondos de SepoliaETH para pagar el gas del deploy.
#             Consigue SepoliaETH en: https://sepoliafaucet.com
# ==============================================================

# URL del nodo RPC de Sepolia (obtén una gratis en Alchemy o Infura)
# Alchemy:  https://dashboard.alchemy.com  → Create App → Sepolia
# Infura:   https://infura.io               → Create Project → Sepolia
SEPOLIA_RPC_URL=

# Clave privada de la cuenta de MetaMask que pagará el despliegue
# NUNCA compartas ni subas este archivo a Git
PRIVATE_KEY=

# (Opcional) API Key de Etherscan para verificar el contrato
# Obtén una en: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
