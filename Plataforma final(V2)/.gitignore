# ==============================================================
# .gitignore para Proyecto Web3 (Hardhat + UUPS + React Vite)
# ==============================================================

/target
.logs/
.ignore/
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/
docs/
.env.*
!.env.example
.AppleDouble
.LSOverride
out/

# ── 1. SEGURIDAD Y SECRETOS (¡NUNCA SUBIR A GITHUB!) ─────────
# Archivo de credenciales reales (Private Key de MetaMask y RPC)
.env
.env.local
.env.*.local
*.env
*.pem
*.key
secrets.json

# ── 2. DEPENDENCIAS ──────────────────────────────────────────
# Paquetes instalados vía npm / yarn
node_modules/
frontend/node_modules/

# ── 3. HARDHAT & COMPILACIÓN DE SOLIDITY ─────────────────────
# Carpetas generadas automáticamente por "npx hardhat compile"
artifacts/
cache/
typechain-types/
.hardhat/

# OpenZeppelin Upgrades (archivos locales de seguimiento del proxy)
.openzeppelin/

# ── 4. FRONTEND (Vite / React) ───────────────────────────────
# Carpeta de build para producción generada por "npm run build"
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local

# ── 5. ALMACENAMIENTO TEMPORAL DEL RELAYER (IPFS) ────────────
# Ignora los textos .txt guardados localmente, pero conserva la carpeta
relayer/ipfs_store/*
!relayer/ipfs_store/.gitkeep

# ── 6. TESTING Y COBERTURA ───────────────────────────────────
coverage/
coverage.json
.nyc_output/

# ── 7. LOGS ──────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── 8. SISTEMA OPERATIVO Y EDITORES (macOS, Windows, IDEs) ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
